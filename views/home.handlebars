<h1 class='mb-4'>All Posts</h1>

<div class='container text-center'>
	<div class='row'>
		{{#each posts}}
			<div class='card ms-3 mb-2' style='max-height: 620px;max-width: 620px;'>
				<div class='row g-0'>
					<div class='col-md-4'>
						<img src='{{this.image}}' class='img-fluid rounded-start img-thumbnail' alt='{{this.title}}' />
					</div>
					<div class='col-md-8 h-100'>
						<div class='card-body text-start'>
							<h5 class='card-title'>{{this.title}}</h5>
							<p class='card-text'>{{truncateLine this.description}}</p>
							<p class='card-text'>
								<small class='text-body-secondary'>Created At{{formatDate this.createdAt}}</small>
							</p>
						</div>
					</div>
				</div>
			</div>
		{{/each}}
	</div>
</div>